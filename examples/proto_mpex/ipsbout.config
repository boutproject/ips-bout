SIM_NAME = ipsbout
SIM_ROOT = $PWD
LOG_FILE = log
LOG_LEVEL = INFO
SIMULATION_MODE = NORMAL

[PORTS]
    NAMES = DRIVER
    [[DRIVER]]
        IMPLEMENTATION = linear_mesh_generator

[linear_mesh_generator]
    CLASS = workers
    SUB_CLASS =
    NAME = linear_mesh_generator
    NPROC = 1
    BIN_PATH =
    SCRIPT =
    MODULE = ipsbout.linear_mesh_generator

    # Machine description with IMAS pf_active + wall IDS data
    MACHINE_FILE = ProtoMPEX_G.json

    # Output grid file to be generated
    GRIDFILE = proto_mpex.nc

    INPUT_FILES = ${MACHINE_FILE}
    OUTPUT_FILES = ${GRIDFILE}

    # Mesh generation parameters
    N_RADIAL_CELLS = 64
    N_AXIAL_CELLS = 64
    R_MIN = 0.05       # Minimum radius [m]
    R_MAX = 0.3        # Maximum radius [m]
    Z_MIN = 0.5        # Minimum axial location [m]
    Z_MAX = 4.2        # Maximum axial location [m]
