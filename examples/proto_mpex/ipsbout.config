SIM_NAME = ipsbout
SIM_ROOT = $PWD
LOG_FILE = log
LOG_LEVEL = INFO
SIMULATION_MODE = NORMAL

HERMES_GRIDFILE = proto_mpex.nc
HELICON_HEATING_FILE = helicon_profile.txt
HERMES_RESTART_TARFILE = BOUT.restart.tar
PLASMA_STATE_FILE = plasma_state.nc

STATE_WORK_DIR = ${SIM_ROOT}/work/state
STATE_FILES = ${HERMES_GRIDFILE} ${HERMES_RESTART_TARFILE}

[PORTS]
    NAMES = DRIVER GRIDGEN ELECTRON_HEATING HERMES
    [[DRIVER]]
        IMPLEMENTATION = hermes_linear_driver

    [[GRIDGEN]]
        IMPLEMENTATION = linear_mesh_generator

    [[ELECTRON_HEATING]]
        IMPLEMENTATION = electron_heating_xyz

    [[HERMES]]
        IMPLEMENTATION = hermes_linear_worker

[hermes_linear_driver]
    CLASS = drivers
    SUB_CLASS =
    NAME = hermes_linear_driver
    NPROC = 1
    BIN_PATH =
    SCRIPT =
    MODULE = ipsbout.hermes_linear_driver

    # Copy the initial BOUT++/Hermes restart file into the state
    INPUT_FILES = ${HERMES_RESTART_TARFILE}
    OUTPUT_FILES =
    STATE_FILES = ${HERMES_RESTART_TARFILE}

[linear_mesh_generator]
    CLASS = workers
    SUB_CLASS =
    NAME = linear_mesh_generator
    NPROC = 1
    BIN_PATH =
    SCRIPT =
    MODULE = ipsbout.linear_mesh_generator

    # Machine description with IMAS pf_active + wall IDS data
    MACHINE_FILE = ProtoMPEX_G.json

    # Output grid file to be generated
    GRIDFILE = ${HERMES_GRIDFILE}

    INPUT_FILES = ${MACHINE_FILE}
    OUTPUT_FILES =
    STATE_FILES = ${GRIDFILE}

    # Mesh generation parameters
    N_RADIAL_CELLS = 64
    N_AXIAL_CELLS = 64
    N_AZIMUTHAL_CELLS = 64
    R_MIN = 0.05       # Minimum radius [m]
    R_MAX = 0.3        # Maximum radius [m]
    Z_MIN = 0.5        # Minimum axial location [m]
    Z_MAX = 4.2        # Maximum axial location [m]

[electron_heating_xyz]
    CLASS = workers
    SUB_CLASS =
    NAME = electron_heating_xyz
    NPROC = 1
    BIN_PATH =
    SCRIPT =
    MODULE = ipsbout.electron_heating_xyz

    GRIDFILE = ${HERMES_GRIDFILE}
    HEATING_FILE = ${HELICON_HEATING_FILE}
    AXIAL_OFFSET = 1.745
    TOTAL_POWER = 16e3

    INPUT_FILES = ${HEATING_FILE}
    OUTPUT_FILES =
    STATE_FILES = ${GRIDFILE}

[hermes_linear_worker]
    CLASS = workers
    SUB_CLASS =
    NAME = hermes_linear_worker
    NPROC = 2
    BIN_PATH = ${SIM_ROOT}/hermes-3
    SCRIPT =
    MODULE = ipsbout.hermes_linear_worker

    GRIDFILE = ${HERMES_GRIDFILE}
    PLASMAFILE = ${PLASMA_STATE_FILE}
    RESTART_TARFILE = ${HERMES_RESTART_TARFILE}

    NEUTRAL_DENSITY = 1e19    # m^-3
    NEUTRAL_TEMPERATURE = 0.1 # eV

    INPUT_FILES =
    OUTPUT_FILES = ${PLASMAFILE}
    STATE_FILES = ${HERMES_RESTART_TARFILE}
    INPUT_STATE_FILES = ${GRIDFILE}
    OUTPUT_STATE_FILES = ${PLASMAFILE}
